\begin{tikzpicture}[
  font=\small,
  box/.style={
    rectangle,
    rounded corners=2pt,
    draw=blue!55!black,
    fill=blue!6,
    align=center,
    minimum width=2.55cm,
    minimum height=0.76cm
  },
  rank/.style={
    rectangle,
    rounded corners=2pt,
    draw=orange!70!black,
    fill=orange!9,
    align=center,
    minimum width=2.55cm,
    minimum height=0.76cm
  },
  keep/.style={
    rectangle,
    rounded corners=2pt,
    draw=green!45!black,
    fill=green!8,
    align=center,
    minimum width=2.55cm,
    minimum height=0.76cm
  },
  arrow/.style={-{Latex[length=2mm]}, thick, draw=gray!70!black}
]
  \node[box]  (state)    at (0,0)       {状态};
  \node[box]  (frontier) at (3.4,0)     {推进前沿};
  \node[box]  (actions)  at (6.8,0)     {候选 SWAP};

  \node[rank] (score)    at (6.8,-1.65) {评分排序};
  \node[box]  (expand)   at (3.4,-1.65) {展开状态};
  \node[keep] (beam)     at (0,-1.65)   {保留 B 条};

  \node[keep] (repair)   at (1.7,-3.30) {尾部修复};
  \node[box]  (queue)    at (5.1,-3.30) {状态队列};

  \draw[arrow] (state) -- (frontier);
  \draw[arrow] (frontier) -- (actions);
  \draw[arrow] (actions) -- (score);
  \draw[arrow] (score) -- (expand);
  \draw[arrow] (expand) -- (beam);
  \draw[arrow] (beam) -- (repair);
  \draw[arrow] (repair) -- (queue);
\end{tikzpicture}
