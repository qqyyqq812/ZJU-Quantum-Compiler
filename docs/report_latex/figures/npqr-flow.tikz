\begin{tikzpicture}[
  node distance=0.8cm and 0.8cm,
  routeStep/.style={rectangle, rounded corners=2pt, draw=blue!55!black, fill=blue!6,
    align=center, minimum width=3.0cm, minimum height=0.9cm, font=\small},
  verify/.style={diamond, aspect=2.1, draw=green!45!black, fill=green!7,
    align=center, inner sep=1pt, font=\small},
  arrow/.style={-{Latex[length=2mm]}, thick, draw=gray!70!black}
]
  \node[routeStep] (input) {输入电路\\硬件拓扑};
  \node[routeStep, right=of input] (pre) {图预处理\\距离矩阵};
  \node[routeStep, right=of pre] (map) {初始映射\\候选选择};
  \node[routeStep, below=of map] (frontier) {前沿门\\状态更新};
  \node[routeStep, left=of frontier] (score) {神经网络\\动作评分};
  \node[routeStep, left=of score] (beam) {束搜索\\动作剪枝};
  \node[routeStep, below=of score] (repair) {局部后缀\\修复};
  \node[verify, below=of frontier] (replay) {轨迹\\复放};
  \node[routeStep, right=of replay] (output) {路由后电路\\指标输出};

  \draw[arrow] (input) -- (pre);
  \draw[arrow] (pre) -- (map);
  \draw[arrow] (map) -- (frontier);
  \draw[arrow] (frontier) -- (score);
  \draw[arrow] (score) -- (beam);
  \draw[arrow] (beam) |- (frontier);
  \draw[arrow] (score) -- (repair);
  \draw[arrow] (repair) -| (frontier);
  \draw[arrow] (frontier) -- (replay);
  \draw[arrow] (replay) -- (output);
\end{tikzpicture}
