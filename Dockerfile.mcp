FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8081

WORKDIR /app

COPY requirements-mcp.txt ./
RUN python -m pip install --upgrade pip \
    && pip install -r requirements-mcp.txt

COPY src ./src
COPY models/default/npqr-default.pt ./models/default/npqr-default.pt

EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/health' % os.getenv('PORT', '8081'), timeout=5)"

CMD ["sh", "-c", "uvicorn src.server.mcp_app:app --host 0.0.0.0 --port ${PORT:-8081}"]
